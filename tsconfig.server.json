{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node10",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [],
    "rootDir": "src",
    "outDir": "lib/cjs",
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src/server/**/*.ts"
  ]
}
