# Which AI provider to use: openai | anthropic | gemini
AI_PROVIDER=anthropic
# Your provider API key. Keep it on the server; never put it in the app.
AI_API_KEY=
# Model id from your provider, e.g. claude-sonnet-5-5
AI_MODEL=claude-sonnet-5-5

# Optional
AI_SYSTEM_PROMPT=You are a helpful assistant inside our app.
# AI_BASE_URL=https://openrouter.ai/api/v1   # any OpenAI-compatible API (with AI_PROVIDER=openai)
# AI_TEMPERATURE=0.7
# AI_MAX_TOKENS=4096
# Require the app to send "Authorization: Bearer <token>"
# CHAT_ACCESS_TOKEN=
