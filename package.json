{
  "name": "react-native-ai-chat-kit",
  "version": "0.4.0",
  "description": "Drop-in AI chat UI for React Native & Expo: streaming markdown, chat history, image/document sharing, voice, and one-line OpenAI / Claude / Gemini setup.",
  "author": "Yogesh Bansal (https://github.com/yogesh2902)",
  "license": "MIT",
  "homepage": "https://github.com/yogesh2902/react-native-ai-chat-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yogesh2902/react-native-ai-chat-kit.git"
  },
  "bugs": {
    "url": "https://github.com/yogesh2902/react-native-ai-chat-kit/issues"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./server": {
      "types": "./lib/cjs/server/index.d.ts",
      "default": "./lib/cjs/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "templates",
    "assets",
    "!src/__tests__",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "react-native",
    "expo",
    "ai",
    "chat",
    "chatgpt",
    "llm",
    "streaming",
    "markdown",
    "openai",
    "anthropic",
    "claude",
    "chat-ui",
    "gemini",
    "voice",
    "attachments",
    "speech-to-text",
    "server"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.74.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.1",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-test-renderer": "^19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
