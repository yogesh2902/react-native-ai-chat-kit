{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "lib": [
      "ES2022"
    ],
    "types": [
      "react-native"
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/server",
    "src/__tests__/server.test.ts"
  ]
}
